# AgriClutch - Environment Configuration Template
# Problem Statement: SIH26132

# Application Settings
APP_NAME=AgriClutch
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
SERVICE_NAME=agriclutch-api

# Server Settings
HOST=0.0.0.0
PORT=8000

# PostgreSQL 16 + TimescaleDB Database Settings
POSTGRES_USER=agrilink
POSTGRES_PASSWORD=agrilink_secure_password
POSTGRES_DB=agrilink_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agrilink:agrilink_secure_password@localhost:5432/agrilink_db

# Redis Caching (Optional for local dev)
REDIS_URL=redis://localhost:6379/0

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
